<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<Fragment>
		<ComponentGroup Id="ExampleComponents" Directory="INSTALLFOLDER">
			<Component>
				<File Id="CalculatorAppEXE" Source="$(var.CalculatorApp.TargetDir)\CalculatorApp.exe" KeyPath="yes" />
			</Component>
			<Component>
				<File Id="CalculatorAppDLL" Source="$(var.CalculatorApp.TargetDir)\CalculatorApp.dll" />
			</Component>
			<Component>
				<File Id="CalculatorAppRuntimeConfig" Source="$(var.CalculatorApp.TargetDir)\CalculatorApp.runtimeconfig.json" />
			</Component>
		</ComponentGroup>
	</Fragment>
</Wix>